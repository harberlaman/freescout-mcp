{
  "name": "freescout-mcp",
  "version": "1.0.0",
  "description": "MCP server for FreeScout helpdesk integration",
  "type": "module",
  "main": "dist/bundle.js",
  "bin": {
    "freescout-mcp": "dist/bundle.js"
  },
  "scripts": {
    "build": "tsc && node node_modules/esbuild/bin/esbuild dist/index.js --bundle --platform=node --format=esm --outfile=dist/bundle.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "prepare": "npm run build",
    "start": "node dist/bundle.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "freescout",
    "helpdesk"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.12.0",
    "esbuild": "^0.28.0",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
